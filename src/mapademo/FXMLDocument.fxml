<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<BorderPane fx:id="rootPane" styleClass="root-pane" stylesheets="@../resources/estiloMain.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="mapademo.FXMLDocumentController">
   <center>
      <VBox prefHeight="556.0" prefWidth="853.0" stylesheets="@../resources/estilos.css">
         <children>
            <SplitPane fx:id="splitPane" dividerPositions="0.15" pickOnBounds="false" prefHeight="506.0" prefWidth="854.0" VBox.vgrow="ALWAYS">
               <items>
                  <VBox prefHeight="38.0" prefWidth="320.0" styleClass="root-pane">
                     <children>
                        <VBox alignment="TOP_CENTER" prefHeight="301.0" prefWidth="316.0" spacing="10.0">
                           <children>
                              <Label alignment="CENTER" maxWidth="1000.0" prefHeight="18.0" prefWidth="242.0" styleClass="titulo-seccion" text="ACTIVIDADES" />
                              <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0" spacing="10.0">
                                 <children>
                                    <Button fx:id="bImportarGpx" mnemonicParsing="false" onAction="#onImportarGpx" styleClass="button-accent" text="Importar GPX" HBox.hgrow="ALWAYS" />
                                    <Button fx:id="bBorrarGpx" mnemonicParsing="false" onAction="#onBorrarGpx" prefHeight="26.0" prefWidth="115.0" styleClass="button-danger" text="Borrar" HBox.hgrow="ALWAYS" />
                                 </children>
                              </HBox>
                              <ListView fx:id="actividades_listview" prefHeight="263.0" prefWidth="280.0" VBox.vgrow="ALWAYS">
                                 <padding>
                                    <Insets left="5.0" right="5.0" />
                                 </padding></ListView>
                              <VBox alignment="TOP_CENTER" prefHeight="288.0" prefWidth="235.0" spacing="10.0">
                                 <children>
                                    <Label alignment="TOP_CENTER" styleClass="titulo-seccion" text="MAPAS" />
                                    <ListView fx:id="mapa_listview" />
                                 </children>
                              </VBox>
                           </children>
                           <padding>
                              <Insets left="10.0" right="10.0" top="10.0" />
                           </padding>
                        </VBox>
                        <VBox alignment="TOP_CENTER" prefHeight="254.0" prefWidth="235.0" spacing="8.0">
                           <padding>
                              <Insets top="15.0" />
                           </padding>
                           <children>
                              <Label alignment="TOP_CENTER" prefHeight="18.0" prefWidth="242.0" styleClass="titulo-seccion" text="ESTADISTICAS" />
                              <GridPane hgap="5.0">
                                 <columnConstraints>
                                    <ColumnConstraints fillWidth="false" hgrow="SOMETIMES" maxWidth="-Infinity" minWidth="10.0" prefWidth="120.0" />
                                    <ColumnConstraints fillWidth="false" hgrow="SOMETIMES" maxWidth="-Infinity" minWidth="10.0" prefWidth="120.0" />
                                    <ColumnConstraints fillWidth="false" hgrow="SOMETIMES" minWidth="10.0" percentWidth="0.0" prefWidth="70.0" />
                                    <ColumnConstraints />
                                 </columnConstraints>
                                 <rowConstraints>
                                    <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                    <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                    <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                    <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                    <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                    <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                    <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                    <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                                 </rowConstraints>
                                 <children>
                                    <Label styleClass="label-stat-key" text="Distancia Total:">
                                       <GridPane.margin>
                                          <Insets left="5.0" />
                                       </GridPane.margin>
                                    </Label>
                                    <Label layoutX="10.0" layoutY="16.0" styleClass="label-stat-key" text="Duración:" GridPane.rowIndex="1">
                                       <GridPane.margin>
                                          <Insets left="5.0" />
                                       </GridPane.margin>
                                    </Label>
                                    <Label layoutX="10.0" layoutY="16.0" styleClass="label-stat-key" text="Velocidad Media:" GridPane.rowIndex="2">
                                       <GridPane.margin>
                                          <Insets left="5.0" />
                                       </GridPane.margin>
                                    </Label>
                                    <Label layoutX="10.0" layoutY="16.0" styleClass="label-stat-key" text="Ritmo Medio:" GridPane.rowIndex="3">
                                       <GridPane.margin>
                                          <Insets left="5.0" />
                                       </GridPane.margin>
                                    </Label>
                                    <Label layoutX="10.0" layoutY="16.0" styleClass="label-stat-key" text="Desnivel Positivo:" GridPane.rowIndex="4">
                                       <GridPane.margin>
                                          <Insets left="5.0" />
                                       </GridPane.margin>
                                    </Label>
                                    <Label layoutX="10.0" layoutY="16.0" styleClass="label-stat-key" text="Desnivel Negativo:" GridPane.rowIndex="5">
                                       <GridPane.margin>
                                          <Insets left="5.0" />
                                       </GridPane.margin>
                                    </Label>
                                    <Label layoutX="10.0" layoutY="16.0" styleClass="label-stat-key" text="Altitud Máxima:" GridPane.rowIndex="6">
                                       <GridPane.margin>
                                          <Insets left="5.0" />
                                       </GridPane.margin>
                                    </Label>
                                    <Label layoutX="10.0" layoutY="16.0" styleClass="label-stat-key" text="Altitud Mínima:" GridPane.rowIndex="7">
                                       <GridPane.margin>
                                          <Insets left="5.0" />
                                       </GridPane.margin>
                                    </Label>
                                    <Label fx:id="lblVelocidadMax" styleClass="label-stat-val" GridPane.columnIndex="2" GridPane.columnSpan="2" GridPane.rowIndex="2" />
                                    <Label fx:id="lblRitmoMedio" styleClass="label-stat-val" GridPane.columnIndex="2" GridPane.rowIndex="3" />
                                    <Label fx:id="lblAltitudMin" GridPane.columnIndex="2" GridPane.rowIndex="7" />
                                    <Label fx:id="lblDuracion" styleClass="label-stat-val" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                                    <Label fx:id="lblDesnivelPos" styleClass="label-stat-val" GridPane.columnIndex="2" GridPane.rowIndex="4" />
                                    <Label fx:id="lblDesnivelNeg" styleClass="label-stat-val" GridPane.columnIndex="2" GridPane.rowIndex="5" />
                                    <Label fx:id="lblAltitudMax" styleClass="label-stat-val" GridPane.columnIndex="2" GridPane.rowIndex="6" />
                                    <Label fx:id="lblDistanciaTotal" styleClass="label-stat-val" GridPane.columnIndex="2" />
                                 </children>
                              </GridPane>
                           </children>
                        </VBox>
                     </children>
                  </VBox>
                  <VBox fx:id="boxVistas">
                     <children>
                        <HBox alignment="CENTER" prefHeight="40.0" prefWidth="200.0" spacing="8.0" style="-fx-background-color: #1e2130;">
                           <children>
                              <Text fill="WHITE" strokeType="OUTSIDE" strokeWidth="0.0" text="Zoom" />
                              <Button mnemonicParsing="false" onAction="#zoomOut" prefHeight="26.0" prefWidth="30.0" text="-">
                                 <HBox.margin>
                                    <Insets left="5.0" right="5.0" />
                                 </HBox.margin>
                              </Button>
                              <Slider fx:id="zoom_slider" max="50.0" maxWidth="200.0" min="10.0" />
                              <Button mnemonicParsing="false" onAction="#zoomIn" prefHeight="26.0" prefWidth="30.0" text="+">
                                 <HBox.margin>
                                    <Insets left="5.0" />
                                 </HBox.margin>
                              </Button>
                           </children>
                           <padding>
                              <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                           </padding>
                           <VBox.margin>
                              <Insets />
                           </VBox.margin>
                        </HBox>
                        <ScrollPane fx:id="map_scrollpane" onMouseMoved="#showPosition" pannable="true" prefHeight="363.0" prefWidth="646.0" VBox.vgrow="ALWAYS">
                           <content>
                              <Pane>
                                 <children>
                                    <ImageView layoutX="-296.0" pickOnBounds="true">
                                       <image>
                                          <Image url="@../resources/upv.jpg" />
                                       </image>
                                    </ImageView>
                                 </children>
                              </Pane>
                           </content>
                        </ScrollPane>
                        <HBox prefHeight="100.0" prefWidth="200.0">
                           <children>
                              <LineChart fx:id="elevationChart" animated="false" prefHeight="150.0" prefWidth="425.0" HBox.hgrow="ALWAYS">
                                 <xAxis>
                                    <NumberAxis label="Distancia(km)" side="BOTTOM" fx:id="xAxis" />
                                 </xAxis>
                                 <yAxis>
                                    <NumberAxis fx:id="yAxis" label="Altitud(m)" side="LEFT" />
                                 </yAxis>
                              </LineChart>
                              <VBox alignment="TOP_CENTER" prefHeight="200.0" prefWidth="100.0" spacing="5.0">
                                 <children>
                                    <Label alignment="TOP_CENTER" styleClass="titulo-seccion" text="POI" />
                                    <ListView fx:id="map_listview" prefHeight="200.0" prefWidth="200.0" VBox.vgrow="ALWAYS" />
                                 </children>
                                 <HBox.margin>
                                    <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
                                 </HBox.margin>
                              </VBox>
                           </children>
                        </HBox>
                     </children>
                  </VBox>
               </items>
            </SplitPane>
         </children>
      </VBox>
   </center>
   <top>
      <HBox alignment="CENTER_LEFT" fillHeight="false" prefHeight="46.0" spacing="8.0" styleClass="hbox_franja" BorderPane.alignment="CENTER">
         <BorderPane.margin>
            <Insets />
         </BorderPane.margin>
         <children>
            <ImageView fx:id="homeButton" fitHeight="31.0" fitWidth="37.0" onMouseClicked="#onHome" pickOnBounds="true" preserveRatio="true">
               <image>
                  <Image url="@../resources/home-svgrepo-com%20(1).png" />
               </image>
               <HBox.margin>
                  <Insets left="15.0" />
               </HBox.margin>
            </ImageView>
            <Region prefHeight="200.0" prefWidth="200.0" HBox.hgrow="ALWAYS" />
            <Button contentDisplay="RIGHT" layoutX="721.0" layoutY="10.0" mnemonicParsing="false" onAction="#onClickSesiones" prefWidth="90.0" text="Sesiones">
               <HBox.margin>
                  <Insets />
               </HBox.margin></Button>
            <Button contentDisplay="RIGHT" layoutX="169.0" layoutY="10.0" mnemonicParsing="false" onAction="#onMapsButton" prefHeight="26.0" prefWidth="90.0" text="Mapas">
               <HBox.margin>
                  <Insets />
               </HBox.margin>
            </Button>
            <Button contentDisplay="RIGHT" layoutX="524.0" layoutY="10.0" mnemonicParsing="false" onAction="#mostrarAyuda" prefHeight="26.0" prefWidth="90.0" text="Ayuda" />
            <MenuButton mnemonicParsing="false" prefHeight="26.0" prefWidth="90.0" text="Usuario">
              <items>
                <MenuItem mnemonicParsing="false" onAction="#OnEditarPerfil" text="Editar Perfil" />
                <MenuItem mnemonicParsing="false" onAction="#OnCerrarSesion" text="Cerrar Sesion" />
              </items>
            </MenuButton>
         </children>
      </HBox>
   </top>
   <bottom>
      <HBox alignment="CENTER_RIGHT" BorderPane.alignment="CENTER">
         <children>
            <Label fx:id="mousePosition" minHeight="-Infinity" minWidth="-Infinity" style="-fx-text-fill: #8a91a8;" text="SceneX:     ScenY:     " wrapText="true" HBox.hgrow="ALWAYS">
               <font>
                  <Font size="11.0" />
               </font></Label>
         </children>
         <BorderPane.margin>
            <Insets bottom="6.0" left="6.0" top="6.0" />
         </BorderPane.margin>
         <padding>
            <Insets right="100.0" />
         </padding>
      </HBox>
   </bottom>
</BorderPane>
